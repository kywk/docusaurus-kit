{
  "name": "docusaurus-theme-pele",
  "version": "0.1.2",
  "description": "Render Mermaid diagrams in Docusaurus with Pele: synchronous, CSS-variable themed SVG.",
  "license": "MIT",
  "author": "kywk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kywk/docusaurus-kit.git",
    "directory": "packages/theme-pele"
  },
  "bugs": {
    "url": "https://github.com/kywk/docusaurus-kit/issues"
  },
  "homepage": "https://github.com/kywk/docusaurus-kit/tree/main/packages/theme-pele#readme",
  "keywords": [
    "docusaurus",
    "docusaurus-theme",
    "mermaid",
    "pele",
    "diagram",
    "svg"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/theme",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "pele": "^1.7.0"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.8.0",
    "@docusaurus/theme-common": "^3.8.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
